<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_card" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="180dp" android:orientation="horizontal" android:padding="14dp" android:background="@drawable/widget_card_background">
<LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="vertical" android:paddingEnd="14dp"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
<ImageView android:id="@+id/widget_avatar" android:layout_width="44dp" android:layout_height="44dp" android:src="@drawable/launcher_art" android:scaleType="fitCenter" android:importantForAccessibility="no" />
<LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="10dp">
<TextView android:id="@+id/widget_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#302541" android:textSize="16sp" android:maxLines="1" android:ellipsize="end" android:textStyle="bold" />
<TextView android:id="@+id/widget_coin" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#816D90" android:textSize="12sp" android:maxLines="1" android:ellipsize="end"  />
</LinearLayout></LinearLayout></LinearLayout>
<LinearLayout android:layout_width="0dp" android:layout_weight="2" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_vertical">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="top">
<LinearLayout android:layout_width="0dp" android:layout_weight="1.1" android:layout_height="wrap_content" android:orientation="vertical" android:paddingEnd="8dp">
<TextView android:id="@+id/widget_funds_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#816D90" android:textSize="12sp" android:maxLines="1" android:ellipsize="end"  /><TextView android:id="@+id/widget_funds" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#392647" android:textSize="28sp" android:textStyle="bold" android:maxLines="2" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="12sp" android:autoSizeMaxTextSize="28sp" android:autoSizeStepGranularity="1sp" />
</LinearLayout>
<LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
<TextView android:id="@+id/widget_profit_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#816D90" android:textSize="12sp" android:maxLines="1" android:ellipsize="end"  /><TextView android:id="@+id/widget_profit" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#238B72" android:textSize="22sp" android:textStyle="bold" android:maxLines="2" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="12sp" android:autoSizeMaxTextSize="22sp" android:autoSizeStepGranularity="1sp" />
</LinearLayout></LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="10dp"><TextView android:id="@+id/widget_round_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#816D90" android:textSize="12sp" android:maxLines="1" android:ellipsize="end"  /><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="4dp">
<TextView android:id="@+id/widget_action" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textColor="#695277" android:textSize="15sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
<TextView android:id="@+id/widget_status" android:layout_width="wrap_content" android:maxWidth="160dp" android:layout_height="wrap_content" android:padding="5dp" android:background="@drawable/widget_status_background" android:textColor="#8A7599" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" />
</LinearLayout></LinearLayout>
</LinearLayout>
</LinearLayout>
