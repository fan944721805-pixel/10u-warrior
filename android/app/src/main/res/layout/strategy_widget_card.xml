<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_card"
 android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
 android:paddingStart="10dp" android:paddingEnd="14dp" android:paddingTop="12dp" android:paddingBottom="12dp" android:background="@color/widget_surface">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
<ImageView android:id="@+id/widget_avatar" android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/launcher_art" android:scaleType="fitCenter" android:importantForAccessibility="no"/>
<LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="8dp">
<TextView android:id="@+id/widget_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#302541" android:textSize="16sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end"/>
<TextView android:id="@+id/widget_coin" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/widget_muted" android:textSize="11sp" android:maxLines="1" android:ellipsize="end"/>
</LinearLayout></LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="10dp" >
<LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:paddingEnd="8dp"><TextView android:id="@+id/widget_funds_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/widget_muted" android:textSize="11sp" android:maxLines="1" android:ellipsize="end"/><TextView android:id="@+id/widget_funds" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#392647" android:textSize="24sp" android:textStyle="bold" android:maxLines="2" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="11sp" android:autoSizeMaxTextSize="24sp" android:autoSizeStepGranularity="1sp"/></LinearLayout>
<LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical"><TextView android:id="@+id/widget_profit_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/widget_muted" android:textSize="11sp" android:maxLines="1" android:ellipsize="end"/><TextView android:id="@+id/widget_profit" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/widget_positive" android:textSize="20sp" android:textStyle="bold" android:maxLines="2" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="11sp" android:autoSizeMaxTextSize="20sp" android:autoSizeStepGranularity="1sp"/></LinearLayout>
</LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="10dp" android:background="@drawable/widget_funds_background" android:padding="8dp">
<LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:paddingEnd="8dp"><TextView android:id="@+id/widget_cash_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/widget_muted" android:textSize="11sp" android:maxLines="1" android:ellipsize="end"/><TextView android:id="@+id/widget_cash" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#392647" android:textSize="13sp" android:textStyle="bold" android:maxLines="2" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="11sp" android:autoSizeMaxTextSize="13sp" android:autoSizeStepGranularity="1sp"/></LinearLayout>
<LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical"><TextView android:id="@+id/widget_reserved_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/widget_muted" android:textSize="11sp" android:maxLines="1" android:ellipsize="end"/><TextView android:id="@+id/widget_reserved" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#392647" android:textSize="13sp" android:textStyle="bold" android:maxLines="2" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="11sp" android:autoSizeMaxTextSize="13sp" android:autoSizeStepGranularity="1sp"/></LinearLayout>
</LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="10dp">
<TextView android:id="@+id/widget_round_label" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textColor="@color/widget_muted" android:textSize="11sp" />
<TextView android:id="@+id/widget_status" android:layout_width="wrap_content" android:maxWidth="100dp" android:layout_height="wrap_content" android:padding="4dp" android:background="@drawable/widget_status_background" android:textColor="@color/widget_muted" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" />
</LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="4dp" >
<LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:paddingEnd="8dp"><TextView android:id="@+id/widget_action" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#695277" android:textSize="15sp" android:textStyle="bold" android:maxLines="2"/></LinearLayout>
<LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical"><TextView android:id="@+id/widget_bet" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#392647" android:textSize="16sp" android:textStyle="bold" android:maxLines="2" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="11sp" android:autoSizeMaxTextSize="16sp" android:autoSizeStepGranularity="1sp"/></LinearLayout>
</LinearLayout>
<LinearLayout android:id="@+id/widget_reference_row" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="6dp">
<TextView android:id="@+id/widget_reference_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/widget_muted" android:textSize="11sp" android:maxLines="1" android:ellipsize="end"/><TextView android:id="@+id/widget_reference" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#392647" android:textSize="13sp" android:textStyle="bold" android:maxLines="2" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="11sp" android:autoSizeMaxTextSize="13sp" android:autoSizeStepGranularity="1sp"/>
</LinearLayout>
<LinearLayout android:id="@+id/widget_previous_row" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="6dp">
<TextView android:id="@+id/widget_previous_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/widget_muted" android:textSize="11sp" android:maxLines="1" android:ellipsize="end"/><TextView android:id="@+id/widget_previous" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#392647" android:textSize="13sp" android:textStyle="bold" android:maxLines="2" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="11sp" android:autoSizeMaxTextSize="13sp" android:autoSizeStepGranularity="1sp"/>
</LinearLayout>
<FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="10dp">
<LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
<TextView android:id="@+id/widget_win_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/widget_muted" android:textSize="11sp" android:maxLines="1" android:ellipsize="end"/><TextView android:id="@+id/widget_win" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#695277" android:textSize="12sp" android:maxLines="2"/>
</LinearLayout>
<TextView android:id="@+id/widget_detail" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/widget_muted" android:textSize="11sp" android:maxLines="1" android:ellipsize="end"/>
</LinearLayout>
</LinearLayout>
